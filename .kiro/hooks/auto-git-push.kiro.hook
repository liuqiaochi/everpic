{
  "enabled": true,
  "name": "Auto Git Commit & Push",
  "description": "When any project file is edited, automatically stage, commit with a descriptive message, and push to GitHub",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.py",
      "*.json",
      "*.html",
      "*.yaml"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "bash scripts/auto-git-push.sh"
  }
}